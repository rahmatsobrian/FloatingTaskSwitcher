<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource Transfer never talks to the internet. This config restricts
  cleartext traffic to local/LAN transfers only (device-to-device), and
  documents intent for reviewers/QA.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
